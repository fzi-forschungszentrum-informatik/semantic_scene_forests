<launch>
  <!-- Parameter file (server_url, api_key, model, temperature, max_tokens, max_steps, ...).
       Defaults to the config shipped with semantic_scene_forests_query so the whole stack is
       configured from a single place. Override to point elsewhere. -->
  <arg name="params_file"
       default="$(find-pkg-share semantic_scene_forests_query)/config/semantic_scene_forests_query.yaml"
       description="YAML parameter file for the scene graph query node."/>

  <!-- A multi-threaded container is required: the agent calls /get_object_visuals
       synchronously inside the action-execution thread (see inspect_object_visual). -->
  <node_container pkg="rclcpp_components" exec="component_container_mt"
                  name="semantic_scene_forests_query_container" namespace="" output="screen">
    <composable_node pkg="semantic_scene_forests_query"
                     plugin="semantic_scene_forests_query::SceneGraphQueryNode"
                     name="semantic_scene_forests_query">
      <param from="$(var params_file)"/>
    </composable_node>
  </node_container>
</launch>
