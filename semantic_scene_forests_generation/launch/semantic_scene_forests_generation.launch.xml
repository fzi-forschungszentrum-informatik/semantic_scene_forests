<launch>
  <arg name="config_file" default="$(find-pkg-share semantic_scene_forests_generation)/config/semantic_scene_forests_generation_config.yaml"
       description="Path to the configuration file"/>
  <arg name="namespace" default=""
       description="Namespace for the node"/>
  <arg name="object_topic" default="/managed_objects"
       description="Topic name for managed objects subscription"/>
  <arg name="graph_topic" default="/scene_graph"
       description="Topic name for scene graph publication"/>
  <arg name="action_name" default="/update_scene_graph"
       description="Action name for update scene graph server"/>
  <arg name="visuals_service" default="/get_object_visuals"
       description="Service name for object visuals client"/>

  <node pkg="semantic_scene_forests_generation" exec="semantic_scene_forests_generation_node" name="semantic_scene_forests_generation" output="screen" namespace="$(var namespace)">
    <param from="$(var config_file)"/>
    <remap from="$(var object_topic)" to="/managed_objects"/>
    <remap from="$(var graph_topic)" to="/scene_graph"/>
    <remap from="$(var action_name)" to="/update_scene_graph"/>
    <remap from="$(var visuals_service)" to="/get_object_visuals"/>
  </node>
</launch>
